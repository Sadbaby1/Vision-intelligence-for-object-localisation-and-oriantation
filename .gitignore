# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Logs and run outputs
Log/
outputs/
*.onnx

# Ultralytics' own download and run folders at the repo root
/weights/
/runs/

# Data: raw captures, Roboflow exports and prepared datasets are too large for git
/data/

# Camera -> board pose: measured per camera setup with `calibrate-board`
/config/board_pose.json

# Local notes, checks and developer tests (not needed to use the trained models)
METHODOLOGY.md
/data_check/
/experiments/
/tests/

# ChArUco board: only the PDF is needed for printing (true A3 scale); the PNG is a copy
/config/charuco_*.png

# Empty placeholder modules
src/vision_intelligence/detection/detector.py
src/vision_intelligence/detection/detected_object.py

# Dataset-preparation tools: only needed where the raw captures are (not for training,
# evaluating, testing or live detection with the trained models)
src/vision_intelligence/camera/session.py
src/vision_intelligence/detection/prepare_labeling.py
src/vision_intelligence/detection/auto_label.py
src/vision_intelligence/detection/split_dataset.py
src/vision_intelligence/detection/pair_depth.py
src/vision_intelligence/detection/build_rgbd_dataset.py

# Models: track only what is needed to use a trained model on another machine
#   model/<dataset>/<run>/weights/best.pt, run_info.json, args.yaml, results.csv
#   model/registry.csv, model/<dataset>/comparison.csv
# Ignored: last.pt, plots, eval/test outputs, the pretrained start (downloaded automatically)
/model/**
!/model/**/
!/model/registry.csv
!/model/*/comparison.csv
!/model/*/*/run_info.json
!/model/*/*/args.yaml
!/model/*/*/results.csv
!/model/*/*/weights/best.pt
!/model/pretrained/yolo11n-obb.pt

# Recorded videos: Only need for testing live detection with the trained models, not for training
recording/